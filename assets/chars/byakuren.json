  "series": "Santuário das Mil Pétalas",
  "author": "Ultimate MUGEN",
  "description": "Chefe da nobre Casa Sakuraba. Desbloqueado ao zerar o Modo História, domina Shunpo, Kido, clones Utsusemi e desperta o Bankai: Mil Pétalas da Sombra e a Espada do Imperador Branco.",
  "color": "#ff7ab8",
  "element": "wind",
  "winQuote": "As pétalas caem em silêncio. Seu orgulho caiu antes delas.",
  "intro": "Sinta-se honrado. Poucos sobrevivem para ver minha lâmina se dispersar.",
  "taunt": "A distância entre nós é como a do céu e da terra.",
  "form": "Bankai: Mil Pétalas da Sombra",
  "boss": false,
  "speed": 1.12,
  "country": "Japão",
  "stage": "spirit",
  "rivals": {
    "kaname": {
      "intro": "Sua lâmina de inverno é admirável, Fuyutsuki... mas a primavera sempre vence.",
      "taunt": "Gelo contra mil pétalas. Mostre sua disciplina."
    },
    "oboro": {
      "intro": "Ilusões não enganam quem controla mil lâminas simultâneas.",
      "taunt": "Seu Eclipse Escarlate será cortado em fragmentos."
    },
    "suzume": {
      "intro": "A Deusa do Relâmpago... ainda tenta superar o meu Shunpo?",
      "taunt": "Velocidade sem elegância é apenas pressa."
    },
    "shion": {
      "intro": "Força bruta sem técnica jamais tocará um nobre da Casa Sakuraba.",
      "taunt": "Balança essa espada pesada o quanto quiser."
    }
  },
