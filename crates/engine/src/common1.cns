;---------------------------------------------------------------- get hit
[Statedef 5000]
type = S
movetype = H
physics = N
velset = 0,0

[State 5000, anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(GetHitVar(groundtype) = 2, 5010, 5000) + min(GetHitVar(animtype), 2)

[State 5000, air]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
value = 5030

[State 5000, trip]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(groundtype) = 3
value = 5070

[State 5000, slide]
type = ChangeState
trigger1 = HitShakeOver
value = 5001

[Statedef 5001]
type = S
movetype = H
physics = S

[State 5001, v]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, done]
type = ChangeState
trigger1 = HitOver
value = 0
ctrl = 1

[Statedef 5010]
type = C
movetype = H
physics = N
velset = 0,0

[State 5010, anim]
type = ChangeAnim
trigger1 = Time = 0
value = 5020 + min(GetHitVar(animtype), 2)

[State 5010, air]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
value = 5030

[State 5010, slide]
type = ChangeState
trigger1 = HitShakeOver
value = 5011

[Statedef 5011]
type = C
movetype = H
physics = C

[State 5011, v]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5011, done]
type = ChangeState
trigger1 = HitOver
value = 11
ctrl = 1

[Statedef 5020]
type = A
movetype = H
physics = N
velset = 0,0

[State 5020, anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(GetHitVar(fall), 5030, 5030)

[State 5020, go]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[Statedef 5030]
type = A
movetype = H
physics = N

[State 5030, anim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim != 5030 && Anim != 5035
value = 5030

[State 5030, v]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5030, g]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, fallanim]
type = ChangeAnim
trigger1 = GetHitVar(fall) && Vel Y > -1 && SelfAnimExist(5050) && Anim != 5050
value = 5050

[State 5030, recover]
type = ChangeState
trigger1 = !GetHitVar(fall) && HitOver && Vel Y > 0
value = 5040

[State 5030, land]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
trigger1 = GetHitVar(fall)
value = 5100

[State 5030, land2]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52

