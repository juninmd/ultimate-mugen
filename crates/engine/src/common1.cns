; Ultimate MUGEN built-in common states (original implementation)

[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, anim]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 0, vel]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, stop]
type = VelSet
trigger1 = abs(vel x) < 2
x = 0

[State 0, ctrl]
type = CtrlSet
trigger1 = Time = 0 && RoundState = 2 && !ctrl && PrevStateNo != 52
value = 1

;---------------------------------------------------------------- crouch
[Statedef 10]
type = C
physics = C
anim = 10

[State 10, stop]
type = VelSet
trigger1 = Time = 0
y = 0

[State 10, done]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

[State 10, release]
type = ChangeState
trigger1 = command != "holddown" && Time > 0
value = 12

[Statedef 11]
type = C
physics = C
anim = 11
sprpriority = 0

[State 11, anim]
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, up]
type = ChangeState
trigger1 = command != "holddown"
value = 12

[Statedef 12]
type = S
physics = S
anim = 12

[State 12, done]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------- walk
[Statedef 20]
type = S
physics = S
sprpriority = 0

[State 20, fwd]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, back]
type = VelSet
trigger1 = command = "holdback"
trigger1 = command != "holdfwd"
x = const(velocity.walk.back.x)

[State 20, animF]
type = ChangeAnim
trigger1 = vel x > 0 && Anim != 20
value = 20

[State 20, animB]
type = ChangeAnim
trigger1 = vel x < 0 && Anim != 21
value = 21

[State 20, stop]
type = ChangeState
trigger1 = command != "holdfwd" && command != "holdback"
value = 0

;---------------------------------------------------------------- jump
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, dir]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ifelse(command = "holdfwd", 1, ifelse(command = "holdback", -1, 0))

[State 40, dir2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, dir3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, go]
type = VelSet
trigger1 = AnimTime = 0
trigger2 = !SelfAnimExist(40) && Time >= 3
x = ifelse(sysvar(1) = 0, const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, ifelse(PrevStateNo = 100, const(velocity.runjump.fwd.x), const(velocity.jump.fwd.x)), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, change]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = !SelfAnimExist(40) && Time >= 3
value = 50
ctrl = 1

[Statedef 45]
type = A
physics = N
ctrl = 0
velset = 0, 0

[State 45, dir]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ifelse(command = "holdfwd", 1, ifelse(command = "holdback", -1, 0))

[State 45, go]
type = VelSet
trigger1 = Time = 0
x = ifelse(sysvar(1) = 0, const(velocity.airjump.neu.x), ifelse(sysvar(1) = 1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, change]
type = ChangeState
trigger1 = Time = 0
value = 50
ctrl = 1

[Statedef 50]
type = A
physics = A

[State 50, anim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(sysvar(1) = 0, 41, ifelse(sysvar(1) = 1, 42, 43))

[State 50, fall]
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = SelfAnimExist(Anim + 3)
trigger1 = Anim = [41, 43]
value = Anim + 3

[Statedef 52]
type = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = VelSet
trigger1 = Time = 0
x = 0

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = Time >= 4 && !SelfAnimExist(47)
value = 0
ctrl = 1

;---------------------------------------------------------------- run / hop
[Statedef 100]
type = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 3]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0

[Statedef 105]
type = A
physics = A
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 2]
type = CtrlSet
trigger1 = Time = 2
value = 1

[Statedef 106]
type = S
physics = S
ctrl = 0
anim = 47

[State 106, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 3]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = Time >= 6
value = 0
ctrl = 1

;---------------------------------------------------------------- guard
[Statedef 120]
type = U
physics = U
ctrl = 0

[State 120, anim]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (StateType = C) + (StateType = A) * 2

[State 120, sc]
type = StateTypeSet
trigger1 = Time = 0 && StateType = S
physics = S

[State 120, cc]
type = StateTypeSet
trigger1 = Time = 0 && StateType = C
physics = C

[State 120, ac]
type = StateTypeSet
trigger1 = Time = 0 && StateType = A
physics = A

[State 120, crouch]
type = StateTypeSet
trigger1 = command = "holddown" && StateType = S
statetype = C
physics = C

[State 120, stand]
type = StateTypeSet
trigger1 = command != "holddown" && StateType = C
statetype = S
physics = S

[State 120, hold]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = !SelfAnimExist(120)
value = 130 + (StateType = C) + (StateType = A) * 2

[State 120, stop]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !InGuardDist
value = 140

[Statedef 130]
type = S
physics = S
anim = 130

[State 130, c]
type = ChangeState
trigger1 = command = "holddown"
value = 131

[State 130, stop]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !InGuardDist
value = 140

[Statedef 131]
type = C
physics = C
anim = 131

[State 131, s]
type = ChangeState
trigger1 = command != "holddown"
value = 130

[State 131, stop]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !InGuardDist
value = 140

[Statedef 132]
type = A
physics = A
anim = 132

[State 132, stop]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !InGuardDist
value = 140

[Statedef 140]
type = U
physics = U
ctrl = 0

[State 140, anim]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (StateType = C) + (StateType = A) * 2

[State 140, end]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = !SelfAnimExist(140) && Time >= 1
value = ifelse(StateType = C, 11, ifelse(StateType = A, 50, 0))
ctrl = 1

[Statedef 150]
type = S
movetype = H
physics = N
velset = 0,0

[State 150, anim]
type = ChangeAnim
trigger1 = Time = 0
value = 150

[State 150, go]
type = ChangeState
trigger1 = HitShakeOver
value = 151

[Statedef 151]
type = S
movetype = H
physics = S
anim = 150

[State 151, v]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 151, ctrl]
type = ChangeState
trigger1 = HitOver
value = 130
ctrl = 1

