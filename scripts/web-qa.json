{
  "defaultTimeoutMs": 1500000,
  "excluded": {
    "web-remote-smoke": "needs network access to GitHub",
    "web-import-probe": "needs a pack path argument, latency probe",
    "web-frame-probe": "manual profiling tool, not a pass/fail check",
    "web-sprite-readiness": "no CLI entry for the wasm dist, covered by cargo tests",
    "web-story-playthrough": "long manual playthrough, not part of the PR gate",
    "web-tour": "manual visual tour of title, menu, select, VS, fight and pause; run again with TOUR_MOBILE=1 for a phone"
  },
  "scenarios": [
    { "name": "web-flow", "shard": "ui", "script": "web-smoke.js", "args": ["{dist}"] },
    { "name": "market-portraits", "shard": "ui", "script": "web-market-smoke.js", "args": ["{dist}"] },
    { "name": "arcade-click", "shard": "ui", "script": "web-arcade-smoke.js", "args": ["{dist}"] },
    { "name": "story", "shard": "ui", "script": "web-story-smoke.js", "args": ["{dist}"] },
    { "name": "epilogue", "shard": "ui", "script": "web-epilogue-smoke.js", "args": ["{dist}"] },
    { "name": "story-studio", "shard": "ui", "script": "web-studio-smoke.js", "args": ["{dist}"] },
    { "name": "defeat-tip", "shard": "ui", "script": "web-defeat-tip-smoke.js", "args": ["{dist}"] },
    { "name": "prefight", "shard": "ui", "script": "web-prefight-smoke.js", "args": ["{dist}"] },
    { "name": "helper", "shard": "ui", "script": "web-helper-smoke.js", "args": ["{dist}"] },
    { "name": "team-7v7", "shard": "ui", "script": "web-team-smoke.js", "args": ["{dist}"] },
    { "name": "team-7v7-touch", "shard": "mobile", "script": "web-team-smoke.js", "args": ["{dist}"], "env": { "TEAM_MOBILE": "1" } },
    { "name": "touch-menu", "shard": "mobile", "script": "web-touch-menu-smoke.js", "args": ["{dist}"] },
    { "name": "touch-fight", "shard": "mobile", "script": "web-touch-smoke.js", "args": ["{dist}"] },
    { "name": "touch-pad", "shard": "mobile", "script": "web-touch-pad-smoke.js", "args": ["{dist}"] },
    { "name": "engine-smoke-mobile", "shard": "mobile", "script": "smoke-web.js", "args": ["{dist}", "{out}"], "env": { "SMOKE_MOBILE": "1" } },
    { "name": "engine-smoke", "shard": "engine", "script": "smoke-web.js", "args": ["{dist}", "{out}"] },
    { "name": "match-1", "shard": "match-1", "script": "web-match-smoke.js", "args": ["{dist}"], "env": { "MATCH_SMOKE_SHARD": "1/2" } },
    { "name": "match-2", "shard": "match-2", "script": "web-match-smoke.js", "args": ["{dist}"], "env": { "MATCH_SMOKE_SHARD": "2/2" } },
    { "name": "mugen-import", "shard": "loading", "script": "web-mugen-smoke.js", "args": ["{dist}", "assets/mugen/elecbyte.zip"], "env": { "MUGEN_SMOKE_CHAR": "kfm" } },
    { "name": "native-awakening", "shard": "loading", "script": "web-awakening-smoke.js", "args": ["{dist}"] },
    { "name": "power-arena", "shard": "loading", "script": "web-power-arena-smoke.js", "args": ["{dist}"], "knownFail": "arena: o oponente derruba o jogador (estado 5110) antes de ele alcançar a primeira plataforma - ver issue #926" },
    { "name": "arena-swarm", "shard": "loading", "script": "web-arena-swarm-smoke.js", "args": ["{dist}"] },
    { "name": "audio-unlock", "shard": "loading", "script": "web-audio-smoke.js", "args": ["{dist}"] },
    { "name": "fatal-trap", "shard": "loading", "script": "web-fatal-smoke.js", "args": ["{dist}"], "expectFatal": true },
    { "name": "preflight-mobile", "shard": "mobile", "script": "web-preflight-smoke.js", "args": ["{dist}"] }
  ]
}
