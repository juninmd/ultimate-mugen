[State 3050, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Unguardable

[State 3050, AimX]
type = VarSet
trigger1 = NearestFoe,Alive
fv = 0
value = (NearestFoe,Pos X - Pos X) * Facing

[State 3050, AimY]
type = VarSet
trigger1 = NearestFoe,Alive
fv = 1
value = NearestFoe,Pos Y - 30 - Pos Y

[State 3050, Speed]
type = VarSet
trigger1 = 1
fv = 2
value = ifelse(MoveContact, 2, 10)

[State 3050, Seek]
type = VelSet
trigger1 = Time >= 1 && NearestFoe,Alive
x = Vel X * 0.82 + 0.18 * Fvar(2) * Fvar(0) / (sqrt(Fvar(0)*Fvar(0) + Fvar(1)*Fvar(1)) + 0.01)
y = Vel Y * 0.82 + 0.18 * Fvar(2) * Fvar(1) / (sqrt(Fvar(0)*Fvar(0) + Fvar(1)*Fvar(1)) + 0.01)

[State 3050, TurnAround]
type = Turn
trigger1 = Vel X < -2

[State 3050, KeepHeading]
type = VelSet
trigger1 = Vel X < -2
x = -Vel X

[State 3050, Pitch]
type = AngleDraw
trigger1 = 1
value = atan(Vel Y / (abs(Vel X) + 0.01)) * 180 / pi

[State 3050, AttackMulSet]
type = AttackMulSet
trigger1 = 1
value = 1+root,fvar(2)+root,fvar(3)

[State 3050, Trans]
type = Trans
trigger1 = 1
trans = add

[State 3050, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Noshadow

[State 3050, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,40
volume = 999

